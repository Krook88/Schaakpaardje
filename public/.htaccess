# Schaakmaatje draait als statische export: geen server nodig, alleen bestanden.
# Deze regels zijn voor Apache (TransIP webhosting).

# Nette 404 in plaats van de standaardpagina van de server.
ErrorDocument 404 /404.html

# De app-bestanden krijgen een hash in hun naam en mogen dus lang blijven hangen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|mp3|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # De twee manifesten wijzen naar de opnames en veranderen bij elke nieuwe zin die
  # Pip inspreekt. Zou een browser er eentje vasthouden, dan hoort een kind de stem
  # van het apparaat terwijl de opname er allang staat — en dat verschil hoor je.
  # De service worker haalt ze met opzet al netwerk-eerst op; dit is dezelfde regel,
  # maar dan voor de browser ervoor.
  <FilesMatch "^manifest\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Zonder dit serveren sommige hosts het webmanifest als platte tekst.
AddType application/manifest+json .webmanifest
AddType audio/mpeg .mp3

# Comprimeren scheelt op een schooltablet echt iets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
